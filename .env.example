# ---------------------------------------------------------------------------
# Copy to .env for local dev. On Railway, set these as service variables instead
# (the container reads them from the environment; .env is gitignored + not copied
# into the image). See DEPLOY.md.
# ---------------------------------------------------------------------------

# --- HubSpot (read-only ingest). Required. ---
HUBSPOT_PRIVATE_APP_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# CRM API base. Global host works for EU portals; recording/transcript media on
# region hosts is handled automatically.
HUBSPOT_BASE_URL=https://api.hubapi.com
# Portal / hub id (reference + sanity checks).
HUBSPOT_HUB_ID=144358290

# --- Transcription (Whisper STT) ---
# Backend: openai (hosted, default for deploy) | groq (hosted) | mlx (local Apple Silicon)
STT_BACKEND=openai
# OpenAI platform key — used by the `openai` backend. Required when STT_BACKEND=openai.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI transcription model. whisper-1 is the model that returns segment-level
# timestamps (which the pipeline needs); don't change unless you know why.
OPENAI_WHISPER_MODEL=whisper-1
# Optional: only if you proxy OpenAI through a different base URL.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Groq key — only if you set STT_BACKEND=groq.
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Analysis engine (Claude) ---
# The Stage A–D analysis runs via the `claude` CLI. On a server it authenticates
# with this key. Required for the one-click "Analyze calls (AI)" run on Railway.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Fireworks (reserved / not yet wired in) ---
# No code path uses this today — the analysis engine is Claude. Kept here so an
# alternative-LLM integration can pick it up later without a config hunt.
# FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxxxxxx

# --- Storage ---
# Where the SQLite DB, transcripts, and deliverables live. On Railway, point these
# at the mounted volume (e.g. DATA_DIR=/data, OUTPUTS_DIR=/data/outputs).
DATA_DIR=./data
OUTPUTS_DIR=./outputs

# --- Ingestion window (inclusive start, exclusive end), ISO date ---
INGEST_WINDOW_START=2026-05-01
INGEST_WINDOW_END=2026-06-01

# --- Scheduled ingest (in-container; see pipeline/scheduler.py) ---
# Enable the nightly ingest+transcribe loop inside the web service. Off by default.
SCHEDULE_INGEST=0
SCHEDULE_HOUR_UTC=6
SCHEDULE_MINUTE_UTC=0
SCHEDULE_RUN_ON_BOOT=0
